{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(docs/**)",
      "Edit(design/**)",
      "Edit(sync/**)",
      "Bash(bash scripts/check-ids.sh)",
      "Bash(npm run render:erd)",
      "Bash(npm run render:screen *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin sync/*)",
      "Bash(git push origin sync/*)",
      "Bash(git push -u origin design/*)",
      "Bash(git push origin design/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Edit(scripts/**)",
      "Edit(CLAUDE.md)",
      "Edit(package.json)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(gh pr merge*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
